# --- core ---
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-machine-key
DATABASE_URL=sqlite:///./strip.db
CORS_ORIGINS=http://localhost:3000

# --- scheduler ---
SCRAPE_CRON_HOUR=6
SCRAPE_CRON_MINUTE=0

# --- AI (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Twitter / X (OAuth1) ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- LinkedIn ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=          # e.g. urn:li:person:xxxx

# --- Facebook Page ---
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# --- Instagram (Graph API, business account) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENTS=          # comma-separated E.164 numbers

# --- Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=strip-bot/1.0
REDDIT_DEFAULT_SUBREDDIT=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=            # comma-separated

# --- Discord ---
DISCORD_WEBHOOK_URL=

# --- Mastodon ---
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
